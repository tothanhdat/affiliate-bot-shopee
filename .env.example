# ==== Core HTTP server ====
PORT=3000

# ==== Affiliate provider ====
# "mock"         -> khong goi API that, sinh short link gia de dev/test khi chua co credentials (T0.1)
# "accesstrade"  -> goi that Accesstrade API cho CA 3 merchant (Shopee/Lazada/TikTok Shop), can ACCESSTRADE_API_KEY ben duoi
# "shopee_direct" -> Shopee di thang qua co che an_redir (SHOPEE_AFFILIATE_ID ben duoi, khong qua Accesstrade,
#                     KHONG can Open API) - Lazada/TikTok Shop VAN CAN ACCESSTRADE_API_KEY (dung chung provider Accesstrade)
AFFILIATE_PROVIDER=mock

# Chi dung khi AFFILIATE_PROVIDER=shopee_direct - affiliate_id CO DINH cua tai khoan (khong phai
# app_id/secret_key cua Open API, khong can xin cap rieng), lay tai affiliate.shopee.vn/account_setting.
# Xem spec_bot_ap_ma_shopee.md muc 5/T3.1 de biet co che an_redir hoat dong the nao.
SHOPEE_AFFILIATE_ID=

# Lay tu dashboard Accesstrade sau khi hoan tat T0.1 (dang ky tai khoan Accesstrade)
ACCESSTRADE_API_KEY=
# Mac dinh theo Accesstrade Product Link Generator API - kiem tra lai voi doc chinh thuc
# trong dashboard Accesstrade truoc khi chay that, endpoint/field co the thay doi theo version API.
ACCESSTRADE_API_BASE=https://api.accesstrade.vn
ACCESSTRADE_ENDPOINT_PATH=/v1/product_link/create
# Timeout goi API affiliate (ms) - qua thoi gian nay se tra loi user bang thong bao loi than thien (T1.5)
ACCESSTRADE_TIMEOUT_MS=4000
# Cache danh sach khuyen mai trong bo nho (ms), tranh goi API lai moi tin nhan
ACCESSTRADE_PROMOTIONS_CACHE_TTL_MS=600000

# --- Campaign rieng cho tung merchant (BAT BUOC de tao affiliate link that cho merchant do) ---
# Lay campaign_id trong dashboard Accesstrade > Campaign, phai o trang thai da dang ky/duyet.
# Neu de trong, merchant do van nhan dien duoc link nhung se bao loi ro rang khi tao affiliate link that.
# Xac minh that (2026-07-31): campaign dung cho Shopee la "Shopee Viet Nam Smartlink cho tat ca thiet bi"
# (merchant "shopee") - can bam DANG KY campaign nay trong dashboard, khac voi viec da co API key.
# Campaign Lazada tuong tu la "Lazada Viet Nam" (merchant "lazada_kol"). Xem id that trong dashboard Accesstrade.
ACCESSTRADE_CAMPAIGN_ID_SHOPEE=
ACCESSTRADE_CAMPAIGN_ID_LAZADA=
# TikTok Shop KHONG dung field nay - endpoint tao link rieng (tiktokshop_product_feeds/create_link)
# da xac minh KHONG can campaign_id (xac minh that 2026-08-18). De trong la dung, khong phai thieu cau hinh.
ACCESSTRADE_CAMPAIGN_ID_TIKTOKSHOP=
# Ten merchant dung cho API khuyen mai (/v1/offers_informations) - da co gia tri mac dinh dung, thuong khong can doi
# ACCESSTRADE_PROMOTIONS_MERCHANT_SHOPEE=shopee
# ACCESSTRADE_PROMOTIONS_MERCHANT_LAZADA=lazada_kol
# TikTok Shop: chua xac minh co dung chung endpoint offers_informations khong - de trong, getPromotions
# se bao MerchantNotConfiguredError neu bi goi (khong anh huong gi vi PROMOTIONS_DISPLAY_LIMIT mac dinh = 0)

# ==== Telegram Adapter ====
# Lay tu BotFather sau khi hoan tat T0.2
TELEGRAM_BOT_TOKEN=

# ==== Zalo Group Adapter ====
# CANH BAO: dung thu vien khong chinh thuc (zca-js) de tu dong hoa 1 tai khoan Zalo
# CA NHAN, tra loi trong cac group ma tai khoan do la thanh vien. Zalo cam hanh vi nay
# trong dieu khoan su dung, tai khoan co the bi khoa - NEN DUNG TAI KHOAN PHU, khong
# dung tai khoan chinh. Mac dinh tat, phai bat co y thuc.
ZALO_GROUP_ENABLED=false
# Noi luu cookie/imei/userAgent sau khi dang nhap QR thanh cong, de lan sau khoi dong
# khong can quet QR lai. File nay = quyen truy cap tai khoan Zalo do - KHONG commit (da gitignore).
ZALO_SESSION_PATH=./data/zalo-session.json
# Anh QR se duoc luu tai day khi can dang nhap (chua co session hoac session het han) -
# mo file nay va quet bang tai khoan Zalo phu da chon o tren.
ZALO_QR_PATH=./data/zalo-qr.png

# ==== Rate limit / anti-spam co ban (T1.6) ====
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=300000

# So link san pham toi da xu ly trong 1 tin nhan Telegram (chong spam nhieu link 1 luc)
MAX_LINKS_PER_MESSAGE=5

# So ma khuyen mai (chung, khong gan san pham cu the) hien thi cho MOI merchant sau khi tra link thanh cong.
# Neu 1 tin nhan co ca link Shopee lan Lazada, se gui rieng 1 tin khuyen mai cho tung merchant. 0 = tat.
# Mac dinh 0 (tat) tu 2026-08-17 - tap trung hoan toan vao cashback, khong con hien ma giam gia chung nua.
PROMOTIONS_DISPLAY_LIMIT=0

# ==== Data store (T1.4) ====
# Duong dan file SQLite, se tu tao neu chua ton tai
DATABASE_PATH=./data/requests.db

# ==== Chia se hoa hong / Ledger (T2.1-T2.4) ====
# DB rieng cho ledger tai chinh, tach khoi DATABASE_PATH de co lap du lieu tien bac
LEDGER_DATABASE_PATH=./data/ledger.db
# % hoa hong user duoc nhan tren PHAN DA TRU THUE/PHI cua moi don (phan con lai thuoc chu bot).
# Chot tai thoi diem ghi nhan don, doi gia tri nay sau KHONG anh huong nguoc cac don da ghi truoc do.
COMMISSION_USER_SHARE_PERCENT=80
# % thue tren hoa hong goc, tru truoc tien. Mac dinh 10% - tham khao theo 1 bot doi thu quan sat duoc
# (xem nguon-kien-thuc-shopee-affiliate-portal.md), CAN TU XAC MINH lai muc thue thuc te ap dung cho ban.
COMMISSION_TAX_PERCENT=10
# % phi san, tinh tren PHAN DA TRU THUE (khong phai tren hoa hong goc). Mac dinh 1% - cung tham khao
# tu bot doi thu, xac minh lai voi network affiliate that ban dung (Accesstrade/Shopee) truoc khi dung that.
COMMISSION_PLATFORM_FEE_PERCENT=1
# Nguong hop ly cua commissionAmount so voi orderAmount (%) khi ghi nhan don tay (record-conversion /
# record-conversions-csv) - vuot qua bi TU CHOI ngay (chan loi go nham vd them 1 so 0). Mac dinh 50%,
# tang len neu ban co campaign hoa hong that su cao hon muc nay.
COMMISSION_MAX_RATIO_PERCENT=50
# So du kha dung toi thieu (VND) de user duoc gui yeu cau rut tien (luon rut toan bo so du)
WITHDRAWAL_THRESHOLD_VND=50000
# Thu muc luu anh chup man hinh bang chung da chuyen khoan - bat buoc dinh kem khi admin bam
# "Danh dau da tra" tren /admin/withdrawals (rui ro so 7 trong rui-ro-can-giai-quyet.md).
WITHDRAWAL_PROOF_DIR=./data/withdrawal-proofs
# Domain/base URL dung de dung link dashboard ca nhan tra ve khi user nhan "idid" cho bot,
# vi du https://bot.example.com - PHAI la domain that user bam vao duoc, khong de localhost khi deploy that.
DASHBOARD_BASE_URL=http://localhost:3000
# Chat ID Telegram cua chu bot, dung de bao khi co yeu cau rut tien moi. Rong = chi xem duoc
# qua lenh thu cong "npx tsx src/scripts/ledgerAdmin.ts list-pending-withdrawals".
ADMIN_TELEGRAM_CHAT_ID=

# ==== Trang quan tri /admin (xem yeu cau rut tien / user / don hang) ====
# Mat khau dang nhap trang /admin, 1 tai khoan mac dinh. Rong = khong ai dang nhap duoc (an toan mac dinh).
ADMIN_PASSWORD=
