# ==== Core HTTP server ====
PORT=3000

# ==== Affiliate provider ====
# "mock"          -> khong goi API that, sinh short link gia de dev/test khi chua co credentials
# "shopee_direct" -> Shopee di thang qua co che an_redir (SHOPEE_AFFILIATE_ID ben duoi, khong can
#                    Open API). Day la nguon affiliate DUY NHAT tu 2026-09-29.
AFFILIATE_PROVIDER=mock

# Chi dung khi AFFILIATE_PROVIDER=shopee_direct - affiliate_id CO DINH cua tai khoan (khong phai
# app_id/secret_key cua Open API, khong can xin cap rieng), lay tai affiliate.shopee.vn/account_setting.
SHOPEE_AFFILIATE_ID=

# ==== Telegram Adapter ====
# Lay tu BotFather sau khi hoan tat T0.2
TELEGRAM_BOT_TOKEN=

# ==== Zalo Group Adapter ====
# CANH BAO: dung thu vien khong chinh thuc (zca-js) de tu dong hoa 1 tai khoan Zalo
# CA NHAN, tra loi trong cac group ma tai khoan do la thanh vien. Zalo cam hanh vi nay
# trong dieu khoan su dung, tai khoan co the bi khoa - NEN DUNG TAI KHOAN PHU, khong
# dung tai khoan chinh. Mac dinh tat, phai bat co y thuc.
ZALO_GROUP_ENABLED=false
# Noi luu cookie/imei/userAgent sau khi dang nhap QR thanh cong, de lan sau khoi dong
# khong can quet QR lai. File nay = quyen truy cap tai khoan Zalo do - KHONG commit (da gitignore).
ZALO_SESSION_PATH=./data/zalo-session.json
# Anh QR se duoc luu tai day khi can dang nhap (chua co session hoac session het han) -
# mo file nay va quet bang tai khoan Zalo phu da chon o tren.
ZALO_QR_PATH=./data/zalo-qr.png

# ==== Rate limit / anti-spam co ban (T1.6) ====
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=300000

# So link san pham toi da xu ly trong 1 tin nhan Telegram (chong spam nhieu link 1 luc)
MAX_LINKS_PER_MESSAGE=5

# So ma khuyen mai (chung, khong gan san pham cu the) hien thi sau khi tra link thanh cong. 0 = tat.
# Mac dinh 0 (tat) tu 2026-08-17 - tap trung hoan toan vao cashback, khong con hien ma giam gia chung nua.
PROMOTIONS_DISPLAY_LIMIT=0

# ==== Data store (T1.4) ====
# Duong dan file SQLite, se tu tao neu chua ton tai
DATABASE_PATH=./data/requests.db

# ==== Chia se hoa hong / Ledger (T2.1-T2.4) ====
# DB rieng cho ledger tai chinh, tach khoi DATABASE_PATH de co lap du lieu tien bac
LEDGER_DATABASE_PATH=./data/ledger.db
# % hoa hong user duoc nhan tren PHAN DA TRU THUE/PHI cua moi don (phan con lai thuoc chu bot).
# Chot tai thoi diem ghi nhan don, doi gia tri nay sau KHONG anh huong nguoc cac don da ghi truoc do.
# Mac dinh 90% - doi tu 80% ngay 2026-08-19 (chu bot giu 10% thay vi 20%).
COMMISSION_USER_SHARE_PERCENT=90
# % thue tren hoa hong goc, tru truoc tien. Mac dinh 10% - tham khao theo 1 bot doi thu quan sat duoc
# CAN TU XAC MINH lai muc thue thuc te ap dung cho ban.
COMMISSION_TAX_PERCENT=10
# % phi san, tinh tren PHAN DA TRU THUE (khong phai tren hoa hong goc). Mac dinh 1% - cung tham khao
# tu bot doi thu, xac minh lai voi Shopee Affiliate truoc khi dung that.
COMMISSION_PLATFORM_FEE_PERCENT=1
# Nguong hop ly cua commissionAmount so voi orderAmount (%) khi ghi nhan don tay (record-conversion /
# record-conversions-csv) - vuot qua bi TU CHOI ngay (chan loi go nham vd them 1 so 0). Mac dinh 50%,
# tang len neu ban co campaign hoa hong that su cao hon muc nay.
COMMISSION_MAX_RATIO_PERCENT=50

# --- Uoc tinh hoa hong hien ngay luc tra link (2026-10-01) ---
# Mac dinh TAT. Tat thi bot tra tin nhan y nhu truoc, khong doi gi ca.
# Nguon du lieu la API cua ben thu ba (addlivetag), KHONG phai Shopee truc tiep - xem
# src/core/commissionLookup.ts de biet vi sao (Open API bi tu choi, API noi bo portal co chu ky
# chong bot gan theo tung request nen khong goi duoc tu server).
COMMISSION_LOOKUP_ENABLED=false
# Lay tai addlivetag.com -> API Key -> Tao Key. BAT BUOC tu 01/10/2026 (thieu -> HTTP 401).
# Bat COMMISSION_LOOKUP_ENABLED ma de trong o day thi tinh nang tu tat kem canh bao trong log.
ADDLIVETAG_API_KEY=
# Tran thoi gian cho moi luot tra. De ngan CO CHU DICH: day la tinh nang phu, khong duoc lam
# cham viec tra link cho user. Qua han thi bo qua phan uoc tinh, van tra link binh thuong.
COMMISSION_LOOKUP_TIMEOUT_MS=2000
# 2 bien duoi CHI dien khi tier tai khoan affiliate cua ban khac mac dinh cua ben cung cap.
# De trong (mac dinh) thi ho tu lay rate that cua tai khoan - da doi chieu voi portal tren 3 san
# pham that ngay 2026-09-30 va khop chinh xac, nen dung dien bua.
COMMISSION_LOOKUP_BASE_RATE_PERCENT=
COMMISSION_LOOKUP_CAP_VND=
# So du kha dung toi thieu (VND) de user duoc gui yeu cau rut tien (luon rut toan bo so du)
# Mac dinh 20.000d - ha tu 50.000d ngay 2026-08-20.
WITHDRAWAL_THRESHOLD_VND=20000
# Thu muc luu anh chup man hinh bang chung da chuyen khoan - bat buoc dinh kem khi admin bam
# "Danh dau da tra" tren /admin/withdrawals (rui ro so 7 trong rui-ro-can-giai-quyet.md).
WITHDRAWAL_PROOF_DIR=./data/withdrawal-proofs
# Domain/base URL dung de dung link dashboard ca nhan tra ve khi user nhan "xemhh" cho bot,
# vi du https://bot.example.com - PHAI la domain that user bam vao duoc, khong de localhost khi deploy that.
DASHBOARD_BASE_URL=http://localhost:3000
# Chat ID Telegram cua chu bot, dung de bao khi co yeu cau rut tien moi. Rong = rot xuong
# ADMIN_ZALO_USER_ID ben duoi; rong CA HAI = chi xem duoc qua lenh thu cong
# "npx tsx src/scripts/ledgerAdmin.ts list-pending-withdrawals".
ADMIN_TELEGRAM_CHAT_ID=
# Kenh thong bao admin DU PHONG qua Zalo DM - danh cho instance chay Zalo-only (khong khai
# TELEGRAM_BOT_TOKEN). CHI duoc dung khi ADMIN_TELEGRAM_CHAT_ID rong.
# PHAI la tai khoan Zalo KHAC tai khoan dang chay bot (bot khong tu nhan tin cho chinh no) -
# thuong la tai khoan Zalo chinh cua chu bot, con bot chay bang tai khoan phu.
# Lay uid: vao /admin/users sau khi tai khoan do nhan tin cho bot 1 lan.
ADMIN_ZALO_USER_ID=

# ==== Trang quan tri /admin (xem yeu cau rut tien / user / don hang) ====
# Mat khau dang nhap trang /admin, 1 tai khoan mac dinh. Rong = khong ai dang nhap duoc (an toan mac dinh).
ADMIN_PASSWORD=
# Chan brute-force POST /admin/login - toi da bao nhieu lan thu (dung/sai deu tinh) MOI IP trong
# 1 khoang thoi gian truoc khi bi tam khoa. Mac dinh 5 lan / 15 phut.
ADMIN_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ==== FAQ tu dong tra loi trong Zalo DM (2026-09-13) ====
# LLM CHI phan loai cau hoi vao 1 trong cac chu de co san; cau tra loi gui cho user LUON la text
# admin soan (sua tren /admin/settings), nen bot khong the bia thong tin ve tien.
# off = tat hoan toan (MAC DINH - bot im lang voi DM khong phai "xemhh"/link san pham, nhu truoc day)
# claude = bat, can ANTHROPIC_API_KEY
FAQ_PROVIDER=off
ANTHROPIC_API_KEY=
FAQ_MODEL=claude-haiku-4-5
# So cau hoi FAQ toi da 1 user duoc hoi trong 1 cua so (chong dot tien API). Mac dinh 5 lan / 10 phut.
FAQ_RATE_LIMIT_MAX=5
FAQ_RATE_LIMIT_WINDOW_MS=600000
